<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
    "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lab.student.mapper.StudentMapper">

    <!-- 自定义结果映射：解决列名与属性名不一致（student_id -> studentId 等） -->
    <resultMap id="studentMap" type="com.lab.student.entity.Student">
        <id     property="studentId" column="student_id"/>
        <result property="studentNo" column="student_no"/>
        <result property="name"      column="name"/>
        <result property="gender"    column="gender"/>
        <result property="major"     column="major"/>
        <result property="stuClass"  column="stu_class"/>
        <result property="age"       column="age"/>
        <result property="score"     column="score"/>
        <result property="enrollDate" column="enroll_date"/>
        <result property="status"    column="status"/>
    </resultMap>

    <!-- 全字段 SQL 片段，供各处复用 -->
    <sql id="allColumns">
        student_id, student_no, name, gender, major, stu_class, age, score, enroll_date, status
    </sql>

    <!-- 查询全部 -->
    <select id="findAll" resultMap="studentMap">
        SELECT <include refid="allColumns"/> FROM student
    </select>

    <!-- 按主键查询 -->
    <select id="findByPk" resultMap="studentMap">
        SELECT <include refid="allColumns"/> FROM student WHERE student_id = #{studentId}
    </select>

    <!-- 新增并回填自增主键 -->
    <insert id="addStudent" parameterType="com.lab.student.entity.Student"
            useGeneratedKeys="true" keyProperty="studentId">
        INSERT INTO student (student_no, name, gender, major, stu_class, age, score, enroll_date, status)
        VALUES (#{studentNo}, #{name}, #{gender}, #{major}, #{stuClass}, #{age}, #{score}, #{enrollDate}, #{status})
    </insert>

    <!-- 按主键全字段更新 -->
    <update id="modifyStudent" parameterType="com.lab.student.entity.Student">
        UPDATE student
        SET student_no = #{studentNo}, name = #{name}, gender = #{gender},
            major = #{major}, stu_class = #{stuClass}, age = #{age},
            score = #{score}, status = #{status}
        WHERE student_id = #{studentId}
    </update>

    <!-- 按主键删除 -->
    <delete id="removeByPk">
        DELETE FROM student WHERE student_id = #{studentId}
    </delete>

    <!-- 多条件动态模糊查询（if / where：自动剔除开头多余的 AND） -->
    <select id="queryByCondition" parameterType="com.lab.student.entity.Student" resultMap="studentMap">
        SELECT <include refid="allColumns"/> FROM student
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="gender != null and gender != ''">
                AND gender = #{gender}
            </if>
            <if test="major != null and major != ''">
                AND major = #{major}
            </if>
            <if test="stuClass != null and stuClass != ''">
                AND stu_class = #{stuClass}
            </if>
            <if test="score != null">
                AND score >= #{score}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <!-- 动态更新：仅更新传入的非空字段（set：自动剔除末尾多余的逗号） -->
    <update id="modifyDynamic" parameterType="com.lab.student.entity.Student">
        UPDATE student
        <set>
            <if test="studentNo != null">student_no = #{studentNo},</if>
            <if test="name != null">name = #{name},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="major != null">major = #{major},</if>
            <if test="stuClass != null">stu_class = #{stuClass},</if>
            <if test="age != null">age = #{age},</if>
            <if test="score != null">score = #{score},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE student_id = #{studentId}
    </update>

    <!-- 批量删除 -->
    <delete id="removeBatch">
        DELETE FROM student WHERE student_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 批量插入 -->
    <insert id="addBatch">
        INSERT INTO student (student_no, name, gender, major, stu_class, age, score, enroll_date, status) VALUES
        <foreach collection="list" item="s" separator=",">
            (#{s.studentNo}, #{s.name}, #{s.gender}, #{s.major}, #{s.stuClass},
             #{s.age}, #{s.score}, #{s.enrollDate}, #{s.status})
        </foreach>
    </insert>

    <!-- 分支选择：优先按姓名精确查，否则按专业查，否则查询全部（choose/when/otherwise） -->
    <select id="queryByPriority" resultMap="studentMap">
        SELECT <include refid="allColumns"/> FROM student
        <choose>
            <when test="name != null and name != ''">
                WHERE name = #{name}
            </when>
            <when test="major != null and major != ''">
                WHERE major = #{major}
            </when>
            <otherwise>
                WHERE status = 1
            </otherwise>
        </choose>
    </select>

</mapper>